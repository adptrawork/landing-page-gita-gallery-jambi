---
import BaseHead from '../components/BaseHead.astro';
import ChannelIcon from '../components/ui/ChannelIcon.astro';
import '../styles/global.css';
import { business, socials, waLink } from '../data/business';

interface Crumb { name: string; path: string }
interface FaqItem { q: string; a: string }
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  breadcrumbs?: Crumb[];
  faq?: FaqItem[];
}
const { title, description, canonicalPath = '/', image, breadcrumbs, faq } = Astro.props;

const site = (Astro.site?.toString() ?? 'https://landing-page-gita-gallery-jambi.adi-putra-work1.workers.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
const cta = waLink(`Halo ${business.name}, saya mau order via WhatsApp.`);
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/katalog', label: 'Katalog' },
  { href: '/promo', label: 'Promo' },
  { href: '/tentang', label: 'Tentang' },
];
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
/* buang angka klaim (mis. jumlah pengikut) — tampilkan handle kanal saja */
const handle = (note: string) => note.split('•')[0].split('—')[0].trim();
const channels = socials.map((s) => ({ label: s.label, url: s.url, handle: handle(s.note) }));
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} breadcrumbs={breadcrumbs} faq={faq} />
</head>
<body class="antialiased">
  <a href="#konten" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn btn--accent">Lewati ke konten</a>

  <header class="sticky top-0 z-40 border-b-2 border-[#171714]" style="background:rgba(255,253,246,.94);backdrop-filter:blur(8px)">
    <nav class="mx-auto max-w-6xl px-4" aria-label="Navigasi utama">
      <input id="nav-toggle" type="checkbox" class="peer sr-only" />
      <div class="flex items-center justify-between gap-3 py-3">
        <a href="/" class="display text-lg leading-none sm:text-xl">
          Gita <span class="accent">Gallery</span>
          <span class="mt-1 block text-[.58rem] font-semibold tracking-[.22em] soft" style="font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;letter-spacing:.22em">JAMBI — KOSMETIK &amp; HAMPERS</span>
        </a>

        <div class="hidden items-center gap-6 md:flex">
          {nav.map((n) => (
            <a
              href={n.href}
              aria-current={active(n.href) ? 'page' : undefined}
              class:list={[
                'border-b-2 px-1 py-2 text-[.78rem] font-bold uppercase tracking-[.12em] transition-colors',
                active(n.href) ? 'border-[#B8301D] accent' : 'border-transparent hover:border-[#171714]',
              ]}
            >{n.label}</a>
          ))}
        </div>

        <div class="flex items-center gap-2">
          <a href={cta} class="btn btn--accent hidden sm:inline-flex">Order WhatsApp</a>
          <label for="nav-toggle" id="nav-label" aria-label="Buka atau tutup menu navigasi" aria-expanded="false" aria-controls="menu-mobile" class="inline-flex min-h-[48px] min-w-[48px] cursor-pointer items-center justify-center border-2 border-[#171714] md:hidden">
            <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg class="icon-close hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </label>
        </div>
      </div>

      <div class="nav-panel md:hidden" id="menu-mobile">
        <div>
          <div class="flex flex-col gap-2 pb-4">
            {nav.map((n) => (
              <a
                href={n.href}
                aria-current={active(n.href) ? 'page' : undefined}
                class:list={[
                  'flex min-h-[48px] w-full items-center border-b-2 px-1 py-3 text-base font-bold uppercase tracking-[.08em]',
                  active(n.href) ? 'border-[#B8301D] accent' : 'border-[#EADFC8]',
                ]}
              >{n.label}</a>
            ))}
            <a href={cta} class="btn btn--accent mt-1 sm:hidden">Order WhatsApp</a>
          </div>
        </div>
      </div>
    </nav>
  </header>

  <main id="konten" class="min-h-[100dvh]"><slot /></main>

  <!-- Footer NAP ringkas -->
  <footer class="mt-20 border-t-2 border-[#171714] bg-[#171714] text-[#FFFDF6]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-6">
          <p class="display text-3xl sm:text-4xl">Gita Gallery <span class="text-[#EFE9A6]">Jambi</span></p>
          <address class="mt-5 space-y-2 not-italic text-sm leading-relaxed">
            <p>{business.address}</p>
            <p>{business.hours}</p>
            <p><a href={cta} class="underline underline-offset-4">WA Admin — {business.phoneDisplay}</a></p>
          </address>
          <p class="mt-4 text-xs" style="color:rgba(255,253,246,.72)">Label Terverifikasi = dicek dari kanal resmi toko; Estimasi = perkiraan. Harga di situs ini estimasi, konfirmasi via WA.</p>
        </div>

        <nav class="md:col-span-3" aria-label="Navigasi footer">
          <p class="text-[.66rem] font-bold uppercase tracking-[.2em]" style="color:rgba(255,253,246,.72)">Halaman</p>
          <ul class="mt-3 space-y-1 text-sm">
            {nav.map((n) => (
              <li><a href={n.href} class="inline-flex min-h-[48px] items-center underline underline-offset-4">{n.label}</a></li>
            ))}
          </ul>
        </nav>

        <div class="md:col-span-3">
          <p class="text-[.66rem] font-bold uppercase tracking-[.2em]" style="color:rgba(255,253,246,.72)">Kanal resmi</p>
          <ul class="mt-3 space-y-1 text-sm">
            {channels.map((c) => (
              <li>
                <a href={c.url} class="inline-flex min-h-[48px] items-center gap-2 underline underline-offset-4">
                  <ChannelIcon name={c.label} size={16} />
                  <span>{c.label} — {c.handle}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap justify-between gap-3 border-t pt-6 text-xs" style="border-color:rgba(255,253,246,.28);color:rgba(255,253,246,.72)">
        <p>© 2026 {business.name} — {business.city}</p>
        <p>Alamat &amp; jam: {business.addressStatus} · {business.hoursStatus}</p>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const t = document.getElementById('nav-toggle') as HTMLInputElement | null;
      const l = document.getElementById('nav-label');
      if (t && l) t.addEventListener('change', () => l.setAttribute('aria-expanded', t.checked ? 'true' : 'false'));
      document.querySelectorAll<HTMLElement>('[data-mapfacade]').forEach((root) => {
        const btn = root.querySelector<HTMLElement>('[data-mapbtn]');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const f = document.createElement('iframe');
          f.src = root.getAttribute('data-src') || '';
          f.title = root.getAttribute('data-title') || 'Peta toko';
          f.loading = 'lazy';
          f.className = 'w-full h-full border-0';
          root.replaceChildren(f);
        }, { once: true });
      });
    });
  </script>
</body>
</html>
