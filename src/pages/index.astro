---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Steps from '../components/ui/Steps.astro';
import Marquee from '../components/ui/Marquee.astro';
import MapFacade from '../components/ui/MapFacade.astro';
import { business, products, waLink, socials } from '../data/business';
import ChannelIcon from '../components/ui/ChannelIcon.astro';

const heroCta = waLink(`Halo ${business.name}, saya mau order via WhatsApp.`);
const featured = products.slice(0, 4);
const embed = `https://maps.google.com/maps?q=${encodeURIComponent(business.mapsQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const marqueeItems = ['KOSMETIK ORIGINAL', 'RESELLER', 'HAMPERS & PARSEL', 'SHOPEE', 'TIKTOK', 'ORDER WA', 'HARGA GROSIR', 'GOFOOD'];

const services = [
  { title: 'Ecer & Grosir Kosmetik', desc: 'Walk-in retail: pilih langsung di toko, stok dikonfirmasi via WA. Dari sunscreen sampai lip cream, harga ecer & grosir.', tone: 'plate--hl' },
  { title: 'Reseller & Komunitas', desc: 'Gabung reseller lewat WA grosir untuk harga partner. Cocok untuk dropshipper dan toko kecil di Jambi.', tone: 'plate' },
  { title: 'Hampers & Parsel Custom', desc: 'Hampers wisuda, lamaran, Lebaran. Atur tema, isi, dan budget via WA khusus hampers.', tone: 'plate--ink' },
];

const steps = [
  { t: 'Pilih produk', d: 'Jelajahi katalog atau sorotan rak, catat nama produk dan estimasi harga.' },
  { t: 'Chat via WhatsApp', d: 'Kirim format pesanan rapi. Admin mengonfirmasi stok dan harga final.' },
  { t: 'Ambil / kirim', d: 'Ambil langsung di toko atau atur pengiriman ojek online.' },
];

const faqs = [
  { q: 'Bagaimana cara pesan produk?', a: 'Pilih produk di katalog, klik Pesan via WA, lalu kirim format pesanan. Admin mengonfirmasi stok dan harga final sebelum Anda datang.' },
  { q: 'Apakah harga di web ini pasti?', a: 'Belum — semua harga estimasi dan dapat berubah. Harga final selalu dikonfirmasi admin via WhatsApp.' },
  { q: 'Bagaimana pesan hampers custom?', a: 'Hubungi WA khusus hampers untuk tema, isi, dan budget. Produksi disesuaikan kesediaan stok.' },
  { q: 'Jam buka dan alamat toko?', a: `${business.hours}. ${business.address}.` },
];

const handle = (note: string) => note.split('•')[0].split('—')[0].trim();
const channels = socials.map((s) => ({ label: s.label, url: s.url, handle: handle(s.note) }));
---
<!-- Ref: retail poster / pop energy — judul poster asimetris, marquee kata kunci, 3 tile layanan asimetris, dua kolom cerita retail/reseller, rak sorotan ber-rule, kategori-order-jam, kontak & kunjungan. -->
<BaseLayout title={business.title} description={business.description} canonicalPath="/" image={business.ogImage} faq={faqs}>
  <!-- 01 Hero poster asimetris -->
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-12 md:pt-14 md:pb-16">
    <div class="grid gap-6 md:grid-cols-12 md:gap-8 items-start">
      <div class="md:col-span-7 reveal" style="--i:0">
        <span class="tag tag--ink">Retail poster • social commerce</span>
        <h1 class="mt-6 display text-[clamp(2.5rem,9vw,6.4rem)]">Kosmetik original & hampers custom</h1>
        <p class="mt-6 max-w-[46ch] text-base sm:text-lg soft">Gita Gallery melayani ecer, grosir, reseller, dan hampers custom di Jambi. Order lewat WhatsApp — admin konfirmasi stok dan harga final sebelum ambil.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={heroCta} class="btn btn--accent">Order WhatsApp</a>
          <a href="/katalog" class="btn btn--ghost">Lihat katalog</a>
        </div>
        <p class="mt-6 font-num text-xs font-bold uppercase tracking-[.18em] soft">Walk-in • Grosir • Hampers • GoFood — {business.hours}</p>
      </div>

      <div class="md:col-span-5 reveal" style="--i:1">
        <div class="plate--ink hard p-6 sm:p-8">
          <span class="tag tag--hl">Buka harian</span>
          <p class="mt-4 display text-3xl sm:text-4xl">{business.hours}</p>
          <p class="mt-3 text-sm" style="color:rgba(255,253,246,.78)">{business.address}</p>
          <div class="mt-6 grid gap-3">
            <div class="border-2 p-4" style="border-color:rgba(255,253,246,.35); background:rgba(255,253,246,.07); color:#FFFDF6">
              <p class="font-num text-xs font-bold uppercase tracking-[.18em]" style="color:#EFE9A6">Kanal</p>
              <p class="mt-1 text-sm">WA Admin · WA Grosir · WA Hampers · Shopee · TikTok</p>
            </div>
            <div class="border-2 p-4" style="border-color:rgba(255,253,246,.35); background:rgba(255,253,246,.07); color:#FFFDF6">
              <p class="font-num text-xs font-bold uppercase tracking-[.18em]" style="color:#EFE9A6">Lokasi</p>
              <p class="mt-1 text-sm">Jl Sei Sawang, seberang Local Space (patokan Tugu Juang)</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Marquee kata kunci -->
  <Marquee items={marqueeItems} />

  <!-- 03 Tiga tile layanan asimetris -->
  <section class="mx-auto max-w-6xl px-4 py-12 md:py-16" aria-labelledby="layanan-h">
    <SectionHead no="03" kicker="Layanan" title="Tiga cara kami melayani" desc="Ecer, grosir, hampers — order dari nol, semua dikonfirmasi via WhatsApp." />
    <div class="mt-8 grid gap-6 md:grid-cols-[2fr_1fr]">
      <article class={`plate hard p-6 sm:p-8 reveal ${services[0].tone === 'plate--hl' ? 'plate--hl' : ''}`} style="--i:0">
        <span class="tag tag--ink">{services[0].title}</span>
        <p class="mt-6 display text-3xl sm:text-4xl">Ecer &amp; Grosir</p>
        <p class="mt-3 max-w-[46ch] text-base leading-relaxed soft">{services[0].desc}</p>
      </article>
      <div class="grid gap-6">
        <article class="plate hard-sm p-6 reveal plate--sand" style="--i:1">
          <span class="tag tag--ink">Reseller</span>
          <p class="mt-4 display text-2xl">{services[1].title}</p>
          <p class="mt-2 text-sm leading-relaxed soft">{services[1].desc}</p>
        </article>
        <article class="plate--ink hard-sm p-6 reveal" style="--i:2">
          <span class="tag tag--hl">Hampers</span>
          <p class="mt-4 display text-2xl">{services[2].title}</p>
          <p class="mt-2 text-sm leading-relaxed" style="color:rgba(255,253,246,.78)">{services[2].desc}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 04 Dua kolom cerita zig-zag -->
  <section class="mx-auto max-w-6xl px-4 py-12 md:py-16" aria-labelledby="cerita-h">
    <SectionHead no="04" kicker="Cerita toko" title="Ritel walk-in vs reseller & hampers" />
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <article class="plate--sand hard p-6 sm:p-8">
        <span class="tag tag--ink">Walk-in retail</span>
        <h3 class="mt-4 display text-2xl sm:text-3xl">Datang, coba, bawa pulang</h3>
        <p class="mt-3 text-base leading-relaxed soft">Pilih langsung di etalase, cek varian bersama admin, lalu bawa pulang hari itu. Cocok untuk kebutuhan harian dan kado cepat.</p>
        <ul class="mt-4 space-y-2 text-sm soft">
          <li>• Ecer tanpa minimum order</li>
          <li>• Stok dikonfirmasi sebelum datang</li>
          <li>• Jam buka harian 08.00–22.00</li>
        </ul>
      </article>
      <article class="plate--ink hard p-6 sm:p-8 md:mt-12">
        <span class="tag tag--hl">Reseller & hampers</span>
        <h3 class="mt-4 display text-2xl sm:text-3xl" style="color:#FFFDF6">Order jauh, kirim rapi</h3>
        <p class="mt-3 text-base leading-relaxed" style="color:rgba(255,253,246,.78)">Gabung reseller untuk harga partner, atau pesan hampers custom untuk wisuda dan lamaran. Produksi dan pengiriman diatur admin.</p>
        <ul class="mt-4 space-y-2 text-sm" style="color:rgba(255,253,246,.78)">
          <li>• WA khusus grosir 0812-6424-9684</li>
          <li>• WA hampers 0852-7308-8931</li>
          <li>• Info pengiriman disepakati admin</li>
        </ul>
      </article>
    </div>
  </section>

  <!-- 05 Katalog sorotan rak ber-rule -->
  <section class="mx-auto max-w-6xl px-4 py-12 md:py-16" aria-labelledby="sorotan-h">
    <SectionHead no="05" kicker="Sorotan rak" title="Produk paling dicari" desc="Harga estimasi — konfirmasi stok dan harga final via WhatsApp." />
    <div class="mt-8 plate rack overflow-hidden">
      {featured.map((p) => {
        const msg = waLink(`Halo ${business.name}, saya mau pesan ${p.name} (${p.price}). Apakah ready?`);
        return (
          <div class="grid gap-4 p-4 sm:grid-cols-[72px_1fr_auto_auto] items-center">
            <img src={p.image} alt={p.alt} width={72} height={60} loading="lazy" decoding="async" class="h-16 w-[72px] object-cover border-2 border-[#171714]" />
            <div>
              <p class="font-bold leading-tight">{p.name}</p>
              <p class="mt-1 font-num text-xs uppercase tracking-[.12em] soft">{p.badge} • {p.stock}</p>
            </div>
            <p class="font-num font-bold text-lg">{p.price}</p>
            <a href={msg} class="btn btn--ghost">WA</a>
          </div>
        );
      })}
    </div>
    <div class="mt-6">
      <a href="/katalog" class="btn btn--ink">Semua {products.length} produk</a>
    </div>
  </section>

  <!-- 06 Kategori, cara order, jam buka -->
  <section class="mx-auto max-w-6xl px-4 py-12 md:py-16" aria-labelledby="k-cat-h">
    <SectionHead no="06" kicker="Kategori & order" title="Kategori, cara order, jam buka" />
    <div class="mt-8 grid gap-6 md:grid-cols-12">
      <div class="md:col-span-5 plate hard-sm p-6">
        <span class="tag tag--hl">Kategori</span>
        <ul class="mt-4 rack">
          {['Kosmetik harian & perawatan', 'Paket & bundling', 'Hampers & parsel custom', 'Produk grosir & reseller'].map((c) => (
            <li class="py-3 font-bold">{c}</li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-4 plate hard-sm p-6">
        <span class="tag tag--hl">Cara order</span>
        <Steps steps={steps} />
      </div>
      <div class="md:col-span-3 plate--hl hard-sm p-6">
        <span class="tag tag--ink">Jam buka</span>
        <p class="mt-4 display text-3xl">{business.hours}</p>
        <p class="mt-2 text-sm soft">{business.address}</p>
      </div>
    </div>
  </section>

  <!-- 07 Kontak & kunjungan -->
  <section class="mx-auto max-w-6xl px-4 py-12 md:py-16" aria-labelledby="kontak-h">
    <SectionHead no="07" kicker="Kontak & kunjungan" title="Alamat toko, map, dan kanal resmi" desc="Cek rute sebelum datang. Order dan tanya stok via kanal resmi." />
    <div class="mt-8 grid gap-6 md:grid-cols-12">
      <div class="md:col-span-5 space-y-4">
        <div class="plate hard-sm p-6">
          <span class="tag tag--hl">Alamat</span>
          <p class="mt-3 text-base font-bold leading-relaxed">{business.address}</p>
          <p class="mt-2 font-num text-xs font-bold uppercase tracking-[.18em] soft">{business.addressStatus}</p>
          <p class="mt-4 text-base leading-relaxed soft">{business.hours}</p>
          <p class="mt-2 font-num text-xs font-bold uppercase tracking-[.18em] soft">{business.hoursStatus}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={heroCta} class="btn btn--accent">Chat WA</a>
            <a href={business.mapsUrl} class="btn btn--ghost">Buka Maps</a>
          </div>
        </div>

        <div class="plate hard-sm p-6">
          <span class="tag tag--hl">Kanal resmi</span>
          <ul class="mt-4 space-y-1">
            {channels.map((c) => (
              <li>
                <a href={c.url} class="flex min-h-[48px] items-center gap-3 font-bold">
                  <span class="inline-flex h-9 w-9 items-center justify-center border-2 border-[#171714]">
                    <ChannelIcon name={c.label} size={18} />
                  </span>
                  <span>{c.label}</span>
                  <span class="soft font-normal text-sm">— {c.handle}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="md:col-span-7">
        <MapFacade embed={embed} />
        <p class="mt-3 text-xs soft">{business.address} — {business.hours}</p>
      </div>
    </div>
  </section>
</BaseLayout>