---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, products, waLink } from '../data/business';
const heroCta = waLink(`Halo ${business.name}, saya mau tanya hampers custom.`);
const featured = products.slice(0, 5);
const gallery = products.slice(0, 6);
---
<BaseLayout title={business.title} description={business.description} canonicalPath="/" image={business.ogImage}>
  <!-- hero split + curtain reveal -->
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center min-h-[88dvh] py-10">
      <div class="md:col-span-6 reveal">
        <p class="flex items-center gap-2 text-sm font-medium text-teal-700">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 9h16v11H4z"/><path d="M4 9l2-5h12l2 5M12 4v15"/></svg>
          <span>{business.rating} • {business.category} • {business.city}</span>
        </p>
        <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Gita Gallery Jambi — Kosmetik & Hampers Terlengkap</h1>
        <p class="mt-5 text-base text-gray-600 leading-relaxed max-w-[65ch]">Jl Sei Sawang seberang Local Space. Kosmetik original, harga grosir, hampers custom, plus GoFood — buka tiap hari 08.00–22.00.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={heroCta} class="bg-teal-700 text-white px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]" style="transition-timing-function:cubic-bezier(0.16,1,0.3,1)">Pesan Hampers Custom</a>
          <a href="/katalog" class="border border-zinc-300 px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:border-zinc-950 active:scale-[0.98]">Lihat Katalog</a>
        </div>
      </div>
      <div class="md:col-span-6 reveal d-1">
        <div class="curtain rounded-[2.5rem] overflow-hidden border border-slate-200/50 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] bg-zinc-100 aspect-[4/3]">
          <img src="/images/gita-hero.jpg" alt="Etalase Gita Gallery Jambi — foto resmi toko" width="800" height="600" loading="eager" class="w-full h-full object-cover" />
        </div>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <div class="rounded-3xl overflow-hidden bg-zinc-100 aspect-square"><img src="/images/gita-avatar.jpg" alt="Logo resmi Gita Gallery Jambi" width="400" height="400" loading="lazy" class="w-full h-full object-cover" /></div>
          <div class="rounded-3xl overflow-hidden bg-zinc-100 aspect-square"><img src="/images/gita-toko-shopee.jpg" alt="Toko Shopee Gita Gallery — tangkapan layar resmi" width="400" height="400" loading="lazy" class="w-full h-full object-cover" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- sticky scroll stack katalog -->
  <section class="max-w-7xl mx-auto px-4 py-12 w-full">
    <p class="text-sm font-medium text-teal-700 reveal">Sorotan Katalog</p>
    <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold reveal d-1">Produk menumpuk saat discroll</h2>
    <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Scroll — tiap kartu menempel lalu tertutup berikutnya. <a class="underline underline-offset-4 text-zinc-900" href="/katalog">Lihat semua {products.length} produk</a></p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7 flex flex-col gap-6">
        {featured.map((p, i) => (
          <article class="stack-card reveal" style={`top:${5.5 + i * 1.2}rem; animation-delay:${i * 0.07}s`}>
            <div class="bg-white border border-slate-200/50 rounded-[2rem] p-5 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)]">
              <div class="grid grid-cols-12 gap-4 items-center">
                <div class="col-span-5 rounded-2xl overflow-hidden bg-zinc-100 aspect-square"><img src={p.image} alt={p.alt} width={p.w} height={p.h} loading="lazy" class="w-full h-full object-cover" /></div>
                <div class="col-span-7">
                  <p class="text-xs font-medium text-teal-700">No.{i + 1} • {p.badge} • {p.stock}</p>
                  <h3 class="mt-1 font-semibold text-lg tracking-tight">{p.name}</h3>
                  <p class="mt-1 font-medium text-sm">{p.price}</p>
                  <a href={waLink(`Halo ${business.name}, saya mau pesan ${p.name} (${p.price}). Apakah ready?`)} class="mt-3 inline-block bg-zinc-950 text-white px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Pesan via WA</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
      <aside class="md:col-span-5 reveal d-2">
        <div class="bg-zinc-950 text-white rounded-[2rem] p-8 md:p-10 md:sticky md:top-24">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 9h16v11H4z"/><path d="M4 9l2-5h12l2 5M12 4v15"/></svg>
          <p class="mt-4 font-semibold text-lg tracking-tight">Hampers? WA khusus.</p>
          <p class="mt-2 text-base text-zinc-400 leading-relaxed max-w-[65ch]">Wisuda, lamaran, Lebaran — custom via WA hampers 0852-7308-8931. Reseller via WA grosir.</p>
          <a href={heroCta} class="mt-5 inline-block bg-teal-700 text-white px-6 py-3 rounded-full text-sm font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Chat WA Hampers</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- dome gallery hampers: coverflow via scroll-x -->
  <section class="max-w-7xl mx-auto px-4 py-12 w-full">
    <p class="text-sm font-medium text-teal-700 reveal">Galeri Hampers</p>
    <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold reveal d-1">Geser galeri parsel</h2>
    <div class="snap-row mt-8 flex gap-5 overflow-x-auto pb-6" aria-label="Galeri hampers, geser horizontal">
      {gallery.map((p) => (
        <figure class="shrink-0 w-[70vw] md:w-[320px] bg-white border border-slate-200/50 rounded-[2rem] p-4 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)] transition-all duration-300 hover:-translate-y-1">
          <div class="rounded-3xl overflow-hidden bg-zinc-100 aspect-[4/3]"><img src={p.image} alt={p.alt} width={p.w} height={p.h} loading="lazy" class="w-full h-full object-cover" /></div>
          <figcaption class="mt-3 px-1"><p class="font-semibold tracking-tight text-sm">{p.name}</p><p class="text-xs text-zinc-500">{p.price} • {p.source}</p></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-14 w-full">
    <div class="reveal">
      <h2 class="text-3xl md:text-4xl tracking-tighter leading-none font-bold max-w-[20ch]">Siap order hampers minggu ini?</h2>
      <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Jelajahi <a class="underline underline-offset-4 text-zinc-900" href="/katalog">katalog</a>, <a class="underline underline-offset-4 text-zinc-900" href="/promo">promo</a>, <a class="underline underline-offset-4 text-zinc-900" href="/tentang">info toko</a>.</p>
      <a href={heroCta} class="mt-6 inline-block bg-teal-700 text-white px-8 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Chat WhatsApp Sekarang</a>
    </div>
  </section>
</BaseLayout>
