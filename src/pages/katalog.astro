---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, products, waLink } from '../data/business';
---
<BaseLayout title={`Katalog — ${business.title}`} description={`Katalog ${business.name} Sei Sawang: ${products.length} kosmetik & hampers, kartu menumpuk sticky, pesan WA.`} canonicalPath="/katalog" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 py-12 w-full min-h-[70dvh]">
    <p class="text-sm font-medium text-teal-700 reveal">Katalog</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold max-w-[20ch] reveal d-1">Semua Produk {business.name}</h1>
    <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Scroll — kartu menempel dan menumpuk. Hampers custom via WA khusus, grosir via WA grosir.</p>
    <div class="mt-8 flex flex-col gap-6 max-w-3xl">
      {products.map((p, i) => (
        <article class="stack-card reveal" style={`top:${5.5 + (i % 5) * 1.1}rem; animation-delay:${(i % 5) * 0.06}s`}>
          <div class="bg-white border border-slate-200/50 rounded-[2rem] p-5 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)]">
            <div class="grid grid-cols-12 gap-4 items-center">
              <div class="col-span-5 rounded-2xl overflow-hidden bg-zinc-100 aspect-square"><img src={p.image} alt={p.alt} width={p.w} height={p.h} loading="lazy" class="w-full h-full object-cover" /></div>
              <div class="col-span-7">
                <p class="text-xs font-medium text-teal-700">No.{i + 1} • {p.badge} • {p.stock}</p>
                <h2 class="mt-1 font-semibold text-lg tracking-tight">{p.name}</h2>
                <p class="mt-1 text-xs text-zinc-400">{p.source}</p>
                <p class="mt-1 font-medium text-sm">{p.price}</p>
                <a href={waLink(`Halo ${business.name}, saya mau pesan ${p.name} (${p.price}). Apakah ready?`)} class="mt-3 inline-block bg-zinc-950 text-white px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Pesan via WA</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="mt-10 max-w-3xl bg-teal-50 border border-teal-900/15 rounded-[2rem] p-6">
      <p class="font-semibold tracking-tight">Tidak ketemu? Stuck di tumpukan?</p>
      <p class="mt-1 text-base text-gray-600"><a class="underline underline-offset-4 text-zinc-900" href={waLink(`Halo ${business.name}, saya cari produk lain. Boleh info katalog lengkap?`)}>Tanya katalog lengkap via WA</a> — admin bantu carikan.</p>
    </div>
  </section>
</BaseLayout>
