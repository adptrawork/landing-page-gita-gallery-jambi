---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/ui/Kicker.astro';
import ProductCard from '../components/ui/ProductCard.astro';
import { business, products, waLink } from '../data/business';
const badges = ['Semua', ...Array.from(new Set(products.map((p) => p.badge)))];
const title = 'Katalog Gita Gallery Jambi — 8 Produk, Pesan via WA';
const description = 'Katalog Gita Gallery Jambi: 8 produk kosmetik & hampers. Filter label Terverifikasi/Estimasi, cek stok dan harga lewat admin WA.';
---
<!-- Ref: katalog rak ber-rule + filter label; empty state yang jelas. -->
<BaseLayout title={title} description={description} canonicalPath="/katalog" image={business.ogImage}>
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-12 md:pt-14 md:pb-16">
    <Kicker no="Katalog" label={`${products.length} produk`} />
    <h1 class="mt-2 display text-[clamp(2.4rem,8vw,5rem)]">Semua produk {business.name}</h1>
    <p class="mt-4 max-w-[65ch] text-base soft">Filter berdasar label. Terverifikasi = dicek sumber resmi. Estimasi = perkiraan. Harga dapat berubah, konfirmasi via WA.</p>

    <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Filter label produk">
      {badges.map((b, i) => (
        <button data-filter={b} class:list={['filter-btn btn min-w-[48px]', i === 0 ? 'btn--ink' : 'btn--ghost']}>{b}</button>
      ))}
    </div>
    <p id="filter-count" class="mt-4 font-num text-xs font-bold uppercase tracking-[.18em] soft" aria-live="polite"></p>

    <div id="skel" class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" aria-hidden="true">
      {[0,1,2].map(() => (
        <div class="plate hard-sm p-5">
          <div class="skeleton aspect-[4/3] w-full border-2 border-[#171714]"></div>
          <div class="skeleton mt-4 h-4 w-2/3"></div>
          <div class="skeleton mt-2 h-4 w-1/3"></div>
        </div>
      ))}
    </div>

    <div id="grid" class="hidden mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((p, i) => (
        <div class:list={['prod reveal', i === 0 ? 'lg:col-span-2' : '']} data-badge={p.badge} style={`--i:${i}`}>
          <ProductCard p={p} titleTag="h2" />
        </div>
      ))}
    </div>

    <div id="empty" class="hidden mt-6 plate hard-sm p-8 text-center">
      <p class="display text-2xl">Tidak ada produk pada filter ini</p>
      <p class="mt-2 text-base soft">Coba filter lain atau tanya katalog lengkap via WhatsApp.</p>
      <a href={waLink(`Halo ${business.name}, saya cari produk lain. Boleh info katalog lengkap?`)} class="mt-5 btn btn--accent">Tanya via WA</a>
    </div>

    <p class="mt-8 text-sm soft">Belum menemukan yang dicari? <a class="font-bold underline underline-offset-4" href={waLink(`Halo ${business.name}, saya cari produk lain. Boleh info katalog lengkap?`)}>Tanya katalog lengkap via WA</a></p>
  </section>

  <script lang="ts">
    document.addEventListener('DOMContentLoaded', () => {
      const btns = Array.from(document.querySelectorAll('.filter-btn'));
      const cards = Array.from(document.querySelectorAll('#grid .prod'));
      const count = document.getElementById('filter-count');
      const empty = document.getElementById('empty');
      const grid = document.getElementById('grid');
      const skel = document.getElementById('skel');
      const ON = ['bg-[#171714]', 'text-[#FFFDF6]', 'border-[#171714]'];
      const OFF = ['bg-transparent', 'text-[#171714]', 'border-[#171714]'];
      const paint = (act) => {
        btns.forEach((b) => {
          const on = b.getAttribute('data-filter') === act;
          ON.forEach((c) => b.classList.toggle(c, on));
          OFF.forEach((c) => b.classList.toggle(c, !on));
        });
      };
      const apply = (f) => {
        let n = 0;
        cards.forEach((c) => {
          const show = f === 'Semua' || c.getAttribute('data-badge') === f;
          c.style.display = show ? '' : 'none';
          if (show) n++;
        });
        if (count) count.textContent = n > 0 ? `Menampilkan ${n} dari ${cards.length} produk` : 'Tidak ada produk pada filter ini';
        if (empty) empty.classList.toggle('hidden', n > 0);
        paint(f);
      };
      btns.forEach((b) => b.addEventListener('click', () => apply(b.getAttribute('data-filter') || 'Semua')));
      apply('Semua');
      setTimeout(() => { if (skel) skel.classList.add('hidden'); if (grid) grid.classList.remove('hidden'); }, 400);
    });
  </script>
</BaseLayout>