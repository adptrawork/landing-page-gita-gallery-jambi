---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, socials, storeNotes, waLink } from '../data/business';
const embed = `https://maps.google.com/maps?q=${encodeURIComponent(business.mapsQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const cta = waLink(`Halo ${business.name}, saya mau tanya rute dan stok produk.`);
---
<BaseLayout title={`Tentang — ${business.title}`} description={`Info ${business.name} Sei Sawang: alamat Tugu Juang, WA admin grosir hampers, GoFood & Shopee.`} canonicalPath="/tentang" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 py-12 w-full min-h-[70dvh]">
    <p class="text-sm font-medium text-teal-700 reveal">Tentang</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold max-w-[20ch] reveal d-1">{business.name}</h1>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-6 reveal d-2">
        <div class="bg-white border border-slate-200/50 rounded-[2rem] p-8 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
          <h2 class="font-semibold text-lg tracking-tight">Alamat & Jam</h2>
          <p class="mt-3 text-base text-gray-600 leading-relaxed">{business.address}</p>
          <p class="mt-1 text-xs font-medium text-teal-700">Alamat: {business.addressStatus}</p>
          <p class="mt-4 text-base text-gray-600">{business.hours}</p>
          <p class="mt-1 text-xs font-medium text-teal-700">Jam: {business.hoursStatus}</p>
          <p class="mt-4 text-base text-gray-600">Telp/WA: {business.phoneDisplay}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={cta} class="bg-teal-700 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Chat WhatsApp</a>
            <a href={business.mapsUrl} class="border border-zinc-300 px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Cari di Maps</a>
          </div>
        </div>
        <div class="mt-6 grid grid-cols-2 gap-3">
          <div class="rounded-3xl overflow-hidden bg-zinc-100 aspect-square"><img src="/images/gita-avatar.jpg" alt="Foto profil resmi Gita Gallery" width="400" height="400" loading="lazy" class="w-full h-full object-cover" /></div>
          <div class="rounded-3xl overflow-hidden bg-zinc-100 aspect-square"><img src="/images/gita-toko-shopee.jpg" alt="Tautan Shopee resmi Gita Gallery" width="400" height="400" loading="lazy" class="w-full h-full object-cover" /></div>
        </div>
      </div>
      <div class="md:col-span-6 reveal d-3">
        <div class="rounded-[2rem] overflow-hidden border border-slate-200/50 aspect-video bg-zinc-100">
          <iframe title={`Peta ${business.name}`} src={embed} loading="lazy" class="w-full h-full"></iframe>
        </div>
        <div class="mt-6 bg-white border border-slate-200/50 rounded-[2rem] p-8">
          <h2 class="font-semibold text-lg tracking-tight">Akun Resmi</h2>
          <ul class="mt-3 flex flex-col gap-2 text-sm">{socials.map((s) => (<li><a href={s.url} class="underline underline-offset-4">{s.label}</a> <span class="text-zinc-500">— {s.note}</span></li>))}</ul>
        </div>
        <div class="mt-6 bg-teal-700 text-white rounded-[2rem] p-8">
          <h2 class="font-semibold text-lg tracking-tight">Catatan Toko</h2>
          <ul class="mt-3 text-base text-teal-50 leading-relaxed list-disc pl-5">{storeNotes.map((n) => (<li>{n}</li>))}</ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
