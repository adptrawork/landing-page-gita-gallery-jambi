---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/ui/Kicker.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import MapFacade from '../components/ui/MapFacade.astro';
import Faq from '../components/ui/Faq.astro';
import ChannelIcon from '../components/ui/ChannelIcon.astro';
import { business, socials, storeNotes, waLink } from '../data/business';

const title = 'Tentang Gita Gallery Jambi — Alamat, Jam Buka & Kontak';
const description = 'Tentang Gita Gallery Jambi: alamat Jl Sei Sawang, jam buka harian 08.00–22.00, order via WA admin & grosir, kanal resmi toko.';
const embed = `https://maps.google.com/maps?q=${encodeURIComponent(business.mapsQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const cta = waLink(`Halo ${business.name}, saya mau tanya rute dan stok produk.`);

const faqs = [
  { q: 'Dimana lokasi Gita Gallery?', a: `${business.address}. Konfirmasi rute via WhatsApp sebelum datang.` },
  { q: 'Jam buka toko?', a: `${business.hours} setiap hari (label ${business.hoursStatus}).` },
  { q: 'Bagaimana order tanpa datang?', a: 'Order via WA admin atau grosir, atau cari Gita Gallery di GoFood, Shopee, dan TikTok.' },
  { q: 'Apakah harga di web ini pasti?', a: 'Belum — semua harga estimasi dan dapat berubah. Harga final selalu dikonfirmasi admin via WhatsApp.' },
];

const handle = (note: string) => note.split('•')[0].split('—')[0].trim();
const channels = socials.map((s) => ({ label: s.label, url: s.url, handle: handle(s.note) }));
---
<!-- Ref: about — alamat/jam, map, kanal resmi, FAQ. -->
<BaseLayout title={title} description={description} canonicalPath="/tentang" image={business.ogImage} faq={faqs}>
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-12 md:pt-14 md:pb-16">
    <Kicker no="Tentang" label={`${business.category} — ${business.city}`} />
    <h1 class="mt-2 display text-[clamp(2.4rem,8vw,5rem)]">{business.name}</h1>
    <p class="mt-4 max-w-[65ch] text-base soft">Gita Gallery di Jl Sei Sawang, seberang Local Space Jambi, melayani ecer, grosir, hampers custom, dan GoFood. Order dan tanya stok via WhatsApp.</p>

    <div class="mt-8 grid gap-6 md:grid-cols-12">
      <div class="md:col-span-5 space-y-4">
        <div class="plate hard-sm p-6">
          <span class="tag tag--hl">Alamat & jam</span>
          <p class="mt-3 text-base font-bold leading-relaxed">{business.address}</p>
          <p class="mt-2 font-num text-xs font-bold uppercase tracking-[.18em] soft">Alamat: {business.addressStatus}</p>
          <p class="mt-4 text-base leading-relaxed soft">{business.hours}</p>
          <p class="mt-2 font-num text-xs font-bold uppercase tracking-[.18em] soft">Jam: {business.hoursStatus}</p>
          <p class="mt-4 text-base font-bold">Telp/WA: {business.phoneDisplay}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={cta} class="btn btn--accent">Chat WhatsApp</a>
            <a href={business.mapsUrl} class="btn btn--ghost">Cari di Maps</a>
          </div>
        </div>

        <div class="plate hard-sm p-6">
          <span class="tag tag--hl">Tanya stok cepat</span>
          <p class="mt-2 text-sm soft">Isi form — chat WhatsApp terisi otomatis.</p>
          <form id="wa-form" class="mt-4 flex flex-col gap-3" novalidate>
            <div id="f-nama-wrap">
              <label for="f-nama" class="text-sm font-bold">Nama</label>
              <input id="f-nama" name="nama" type="text" autocomplete="name" placeholder="Nama kamu" class="mt-1 w-full px-4" />
              <p class="field-err mt-1 text-sm" style="color:#B8301D">Nama wajib diisi (min. 2 huruf).</p>
            </div>
            <div id="f-pesan-wrap">
              <label for="f-pesan" class="text-sm font-bold">Kebutuhan</label>
              <textarea id="f-pesan" name="pesan" rows="3" placeholder="Contoh: stok sunscreen + harga grosir" class="mt-1 w-full px-4 py-3"></textarea>
              <p class="field-err mt-1 text-sm" style="color:#B8301D">Tulis kebutuhanmu dulu (min. 5 karakter).</p>
            </div>
            <button type="submit" class="btn btn--accent">Kirim via WhatsApp</button>
          </form>
        </div>

        <div class="plate hard-sm p-6">
          <span class="tag tag--hl">Akun resmi</span>
          <ul class="mt-4 space-y-1">
            {channels.map((c) => (
              <li>
                <a href={c.url} class="flex min-h-[48px] items-center gap-3 font-bold">
                  <span class="inline-flex h-9 w-9 items-center justify-center border-2 border-[#171714]">
                    <ChannelIcon name={c.label} size={18} />
                  </span>
                  <span>{c.label}</span>
                  <span class="soft font-normal text-sm">— {c.handle}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="md:col-span-7 space-y-4">
        <MapFacade embed={embed} />
        <p class="mt-3 text-xs soft">{business.address} — {business.hours}</p>
        <div class="plate hard-sm p-6">
          <span class="tag tag--hl">Catatan toko</span>
          <ul class="mt-3 space-y-2 text-base soft">
            {storeNotes.map((n) => (<li>• {n}</li>))}
          </ul>
          <p class="mt-4 text-sm soft">Harga dapat berubah, konfirmasi via WA toko.</p>
        </div>
      </div>
    </div>

    <div class="mt-12">
      <SectionHead no="FAQ" kicker="Sering ditanyakan" title="Tanya jawab singkat" />
      <Faq items={faqs} />
    </div>
  </section>

  <script lang="ts" define:vars={{ storePhone: business.phone, storeName: business.name }}>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('wa-form');
      const namaEl = document.getElementById('f-nama');
      const pesanEl = document.getElementById('f-pesan');
      const wNama = document.getElementById('f-nama-wrap');
      const wPesan = document.getElementById('f-pesan-wrap');
      if (form) form.addEventListener('submit', (e) => {
        e.preventDefault();
        const n = (namaEl instanceof HTMLInputElement) ? (namaEl.value || '').trim() : '';
        const p = (pesanEl instanceof HTMLTextAreaElement) ? (pesanEl.value || '').trim() : '';
        const okN = n.length >= 2;
        const okP = p.length >= 5;
        if (wNama) wNama.classList.toggle('field-invalid', !okN);
        if (wPesan) wPesan.classList.toggle('field-invalid', !okP);
        if (!okN || !okP) { (!okN ? namaEl : pesanEl)?.focus(); return; }
        const text = encodeURIComponent(`Halo ${storeName}, saya ${n}. ${p}`);
        window.open(`https://wa.me/${storePhone}?text=${text}`, '_blank', 'noopener');
      });
    });
  </script>
</BaseLayout>