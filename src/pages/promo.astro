---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/ui/Kicker.astro';
import Steps from '../components/ui/Steps.astro';
import { business, promos, waLink } from '../data/business';
const title = 'Promo Gita Gallery Jambi — Bundling Hampers & Reseller';
const description = 'Promo Gita Gallery Jambi: bundling hampers & program reseller. Semua estimasi, harga final & ketersediaan dikonfirmasi admin via WhatsApp.';
const steps = [
  { t: 'Pilih tier promo', d: 'Cocokkan kebutuhan dengan tier di bawah — catat judul promonya.' },
  { t: 'Klik klaim via WA', d: 'Tombol klaim mengisi format chat otomatis berisi judul promo.' },
  { t: 'Konfirmasi admin', d: 'Admin memastikan promo masih berlaku dan harga final.' },
];
---
<!-- Ref: promo bundling & reseller — tier asimetris + cara klaim. -->
<BaseLayout title={title} description={description} canonicalPath="/promo" image={business.ogImage}>
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-12 md:pt-14 md:pb-16">
    <Kicker no="Promo" label={`${promos.length} tier aktif`} />
    <h1 class="mt-2 display text-[clamp(2.4rem,8vw,5rem)]">Bundling & promo {business.name}</h1>
    <p class="mt-4 max-w-[65ch] text-base soft">Semua promo estimasi mengikuti info toko — harga final wajib konfirmasi via WA sebelum order.</p>

    <div class="mt-8 grid gap-6 md:grid-cols-12">
      {promos.map((m, i) => (
        <div class={i === 0 ? 'md:col-span-7' : i === 1 ? 'md:col-span-5' : 'md:col-span-12'}>
          <div class="plate hard p-6 md:p-10 h-full">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="tag tag--hl">Tier 0{i + 1}</span>
              <span class="font-num text-xs font-bold uppercase tracking-[.18em] soft">{m.status}</span>
            </div>
            <h2 class="mt-4 display text-2xl sm:text-3xl">{m.title}</h2>
            <p class="mt-2 max-w-[65ch] text-base leading-relaxed soft">{m.desc}</p>
            <a href={waLink(`Halo ${business.name}, saya mau klaim promo: ${m.title}. Apakah masih berlaku?`)} class="mt-5 btn btn--ink">Klaim via WA</a>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12">
      <h2 class="font-num text-xs font-bold uppercase tracking-[.2em] soft">CARA KLAIM</h2>
      <Steps steps={steps} />
    </div>

    <div class="mt-8 plate--sand hard p-8">
      <h2 class="font-bold text-lg">Disclaimer</h2>
      <p class="mt-2 max-w-[65ch] text-base leading-relaxed soft">Harga dapat berubah, konfirmasi via WA toko. Promo dapat berakhir sewaktu-waktu mengikuti kebijakan toko. Screenshot halaman ini bukan bukti klaim harga.</p>
    </div>
  </section>
</BaseLayout>