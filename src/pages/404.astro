---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
const title = '404 — Halaman Tidak Ditemukan | Gita Gallery Jambi';
const description = 'Halaman tidak ditemukan di Gita Gallery Jambi. Kembali ke beranda atau jelajahi katalog produk kosmetik dan hampers custom.';
---
<BaseLayout title={title} description={description} canonicalPath="/404" image={business.ogImage}>
  <section class="mx-auto max-w-6xl px-4 py-20 md:py-28 min-h-[70dvh] grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
    <div class="md:col-span-7">
      <span class="tag tag--accent">404</span>
      <h1 class="mt-4 display text-[clamp(2.5rem,10vw,7rem)]">Halaman tidak ditemukan</h1>
      <p class="mt-4 max-w-[65ch] text-base soft">Tautan mungkin berubah. Kembali ke beranda atau jelajahi katalog kosmetik dan hampers.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn--accent">Beranda</a>
        <a href="/katalog" class="btn btn--ghost">Katalog</a>
      </div>
    </div>
    <div class="md:col-span-5">
      <div class="plate--ink hard p-6">
        <p class="tag tag--hl">Gita Gallery</p>
        <p class="mt-4 text-sm" style="color:rgba(255,253,246,.78)">{business.address}</p>
        <p class="mt-1 text-sm" style="color:rgba(255,253,246,.78)">{business.hours}</p>
        <a href={`https://wa.me/${business.phone}`} class="mt-4 btn btn--accent w-full">Chat WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>