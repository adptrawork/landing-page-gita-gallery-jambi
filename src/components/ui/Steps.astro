---
interface Step { t: string; d: string }
interface Props { steps: Step[] }
const { steps } = Astro.props;
---
<ol class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
  {steps.map((st, i) => (
    <li class="plate hard-sm p-6">
      <p class="tag tag--hl">0{i + 1}</p>
      <p class="mt-3 font-bold text-lg leading-tight">{st.t}</p>
      <p class="mt-1 text-base leading-relaxed soft">{st.d}</p>
    </li>
  ))}
</ol>