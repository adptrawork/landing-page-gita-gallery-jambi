---
/**
 * Ikon kanal inline (SVG, stroke 1.5–2, currentColor). Tanpa emoji.
 */
interface Props { name: string; size?: number }
const { name, size = 20 } = Astro.props;
const k = name.toLowerCase();
const isGift = k.includes('hampers') || k.includes('parsel');
const isShopee = k.includes('shopee');
const isInstagram = k.includes('instagram');
const isTiktok = k.includes('tiktok');
---
{isGift && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3.5 10.5h17V20h-17z" /><path d="M2.5 7h19v3.5h-19z" /><path d="M12 7v13" />
    <path d="M12 7C10.6 4 6.4 3.5 6.4 5.9c0 1 .9 1.1 1.8 1.1H12Z" />
    <path d="M12 7c1.4-3 5.6-3.5 5.6-1.1 0 1-.9 1.1-1.8 1.1H12Z" />
  </svg>
)}
{isShopee && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5.2 8h13.6l-1.1 12.2H6.3L5.2 8Z" /><path d="M9.1 8a2.9 2.9 0 0 1 5.8 0" />
  </svg>
)}
{isInstagram && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="3.8" /><circle cx="16.9" cy="7.1" r=".6" />
  </svg>
)}
{isTiktok && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14 4.2v9.4a3.4 3.4 0 1 1-3.4-3.4" /><path d="M14 6c.7 1.9 2.1 3 4.1 3.2" />
  </svg>
)}
{!(isGift || isShopee || isInstagram || isTiktok) && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3.2a8.8 8.8 0 0 0-7.5 13.3L3.2 20.8l4.4-1.2A8.8 8.8 0 1 0 12 3.2Z" />
    <path d="M8.6 9.3c0 2.9 2.2 5.1 5.1 5.1a1 1 0 0 0 1-1l-.2-.9-1.2-.4-.7.7a4.3 4.3 0 0 1-2.1-2.1l.7-.7-.4-1.2-.9-.2a1 1 0 0 0-1 1Z" />
  </svg>
)}
