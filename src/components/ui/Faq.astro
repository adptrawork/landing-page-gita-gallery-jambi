---
interface Item { q: string; a: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
  {items.map((f) => (
    <details class="faq plate hard-sm p-6">
      <summary class="font-bold text-lg leading-tight">
        <span>{f.q}</span>
        <span class="plus font-num text-2xl leading-none" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 text-base leading-relaxed soft">{f.a}</p>
    </details>
  ))}
</div>