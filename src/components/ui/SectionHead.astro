---
interface Props { no: string; kicker: string; title: string; desc?: string; headingId?: string }
const { no, kicker, title, desc, headingId } = Astro.props;
---
<div class="max-w-[72ch]">
  <p class="font-num text-[.72rem] font-bold uppercase tracking-[.2em] soft">{no} — {kicker}</p>
  <h2 id={headingId} class="mt-2 display text-3xl sm:text-4xl md:text-5xl">{title}</h2>
  {desc && <p class="mt-3 max-w-[65ch] text-base leading-relaxed soft">{desc}</p>}
</div>