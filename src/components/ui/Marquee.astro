---
interface Props { items: string[] }
const { items } = Astro.props;
const row = [...items, ...items];
---
<div class="marquee border-y-2 border-[#171714] bg-[#171714] text-[#FFFDF6]" aria-hidden="true">
  <div class="marquee-track py-4">
    {row.map((m) => (
      <span class="display text-2xl sm:text-3xl whitespace-nowrap">{m}<span class="text-[#EFE9A6]"> •</span></span>
    ))}
  </div>
</div>