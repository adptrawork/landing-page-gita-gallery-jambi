---
interface Props { items: string[] }
const { items } = Astro.props;
const row = [...items, ...items];
---
<div class="marquee bg-teal-50 border-y border-zinc-200" aria-hidden="true">
  <div class="marquee-track py-3">
    {row.map((m) => (
      <span class="font-mono text-xs tracking-[0.2em] uppercase text-teal-700 border border-teal-200/60 text-teal-800 rounded-full px-4 py-2 whitespace-nowrap">{m}</span>
    ))}
  </div>
</div>
