---
import { business, waLink } from '../../data/business';
interface P { name: string; price: string; badge: string; stock: string; image: string; alt: string; w: number; h: number; source: string; }
interface Props { p: P; titleTag?: string }
const { p, titleTag = "h3" } = Astro.props;
const Tag = titleTag as any;
const msg = waLink(`Halo ${business.name}, saya mau pesan ${p.name} (${p.price}). Apakah ready?`);

---
<article class="plate hard-sm p-5">
  <div class="overflow-hidden border-2 border-[#171714] bg-[#EADFC8] aspect-[4/3]">
    <img src={p.image} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" class="w-full h-full object-cover" />
  </div>
  <div class="mt-4 flex items-center justify-between gap-2 flex-wrap">
    <span class="tag tag--hl">{p.badge}</span>
    <span class="font-num text-xs font-bold uppercase tracking-[.12em] soft">{p.stock}</span>
  </div>
  <Tag class="mt-2 text-xl sm:text-2xl font-bold leading-tight">{p.name}</Tag>
  <p class="mt-1 text-xs soft">{p.source}</p>
  <div class="mt-4 flex items-center justify-between gap-3 flex-wrap">
    <p class="font-num text-lg font-bold">{p.price}</p>
    <a href={msg} class="btn btn--ink">Pesan WA</a>
  </div>
</article>