---
interface Props { title: string; description: string; canonicalUrl: string; image?: string; }
import { business } from '../data/business';
const { title, description, canonicalUrl, image = business.ogImage } = Astro.props;
const ogImage = new URL(image, Astro.site ?? Astro.url).toString();
const faq = [
  { q: 'Apakah Gita Gallery bisa pesan hampers custom?', a: 'Bisa. Gita melayani hampers dan parsel custom untuk wisuda, lamaran, dan Lebaran via WA khusus hampers 0852-7308-8931.' },
  { q: 'Bagaimana cara gabung reseller Gita Gallery?', a: 'Chat WA grosir 0812-6424-9684 untuk syarat reseller dan daftar harga grosir. WA admin 0812-6424-9685 untuk ecer.' },
  { q: 'Apakah bisa order tanpa datang ke toko?', a: 'Bisa. Cari Gita Gallery di GoFood untuk order cepat, atau order via Shopee gitakosmetikjambi dan TikTok @gitagallery.' },
];
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="id_ID" />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org", "@type": "GiftStore",
  name: business.name, url: Astro.site?.toString(), image: ogImage, description: description,
  address: { "@type": "PostalAddress", streetAddress: business.address, addressLocality: business.city, addressRegion: "Jambi", addressCountry: "ID" },
  telephone: business.phone, openingHours: "Mo-Su 08:00-22:00",
  aggregateRating: { "@type": "AggregateRating", ratingValue: business.rating, reviewCount: business.reviewCount }
})} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } }))
})} />
<link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
<link rel="stylesheet" href="https://fonts.cdnfonts.com/css/geist" media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href="https://fonts.cdnfonts.com/css/geist" /></noscript>
